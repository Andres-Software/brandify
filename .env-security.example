# Configuração usada pelo bin/fix-permissions.sh no hosting compartilhado.
# Copie para .env-security e ajuste os valores para o seu provedor.

# Modo aplicado a diretórios (padrão Laravel em shared hosting: 755).
DIR_MODE=755

# Modo aplicado a arquivos (padrão Laravel em shared hosting: 644).
FILE_MODE=644

# Modo aplicado a storage/ e bootstrap/cache/ (precisam ser graváveis pelo PHP).
WRITABLE_DIR_MODE=775

# Modo aplicado ao artisan (precisa ser executável).
EXECUTABLE_FILE_MODE=755
