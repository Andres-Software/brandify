# .htaccess para a RAIZ do hosting (ex: public_html/.htaccess) quando o
# Brandify convive lado a lado com outro site, em vez de responder pela
# raiz do domínio.
#
# Estrutura esperada:
#
#   public_html/
#   ├── index.html (ou outro conteúdo do site principal)
#   ├── .htaccess       <- este arquivo, copiado para cá
#   └── brandify/       <- clone deste repositório (o nome da pasta
#   │                      pode ser qualquer um, não precisa bater com
#   │                      o segmento da URL usado abaixo)
#       └── public/
#           ├── index.php
#           └── .htaccess (o padrão do Laravel, não mexer)
#
# O segmento da URL pública ("app" abaixo) é independente do nome da
# pasta no disco ("brandify" abaixo) — ajuste os dois conforme
# necessário, eles não precisam ser iguais.
#
# Resultado: dominio.com/app/admin funciona sem precisar digitar
# dominio.com/brandify/public/admin.
#
# Se o Brandify responder pela raiz do domínio (document root do site
# já apontando direto para brandify/public/), este arquivo não é
# necessário — o Apache/nginx já resolve isso pela configuração do
# virtual host, não por reescrita de URL.

RewriteEngine On
RewriteCond %{REQUEST_URI} ^/app/(?!public/)
RewriteRule ^app/(.*)$ brandify/public/$1 [L]
